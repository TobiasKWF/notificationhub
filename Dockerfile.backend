# ============================================================
# NotificationHub – Backend Dockerfile
# Multi-arch: linux/amd64, linux/arm64
# ============================================================

# --- Build stage ---
FROM node:22-alpine AS builder

WORKDIR /app

# Install build deps
RUN apk add --no-cache python3 make g++

# Copy workspace manifests
COPY package.json package-lock.json* ./
COPY packages/backend/package.json ./packages/backend/

# Install all deps
RUN npm ci --workspace=packages/backend

# Copy backend source
COPY packages/backend ./packages/backend

# Generate Prisma client
RUN npm run db:generate --workspace=packages/backend

# Compile TypeScript
RUN npm run build --workspace=packages/backend

# --- Runtime stage ---
FROM node:22-alpine AS runner

WORKDIR /app

# Security: non-root user
RUN addgroup -S notificationhub && adduser -S notificationhub -G notificationhub

# Copy only production artifacts
COPY --from=builder /app/packages/backend/dist ./dist
COPY --from=builder /app/packages/backend/node_modules ./node_modules
COPY --from=builder /app/packages/backend/prisma ./prisma

# Copy static frontend build (built separately)
# COPY --from=frontend-builder /app/packages/frontend/dist ./public

# Runtime dirs
RUN mkdir -p /app/data /app/plugins && chown -R notificationhub:notificationhub /app

USER notificationhub

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

# Run migrations then start
CMD ["sh", "-c", "node dist/scripts/migrate.js && node dist/index.js"]
