// NotificationHub – Prisma Schema (MySQL / MariaDB)
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("VIEWER")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  apiTokens    ApiToken[]
  acknowledged Notification[] @relation("AcknowledgedBy")
  @@map("users")
}

model ApiToken {
  id          String    @id @default(uuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  @@map("api_tokens")
}

// ─── Notifications

model Notification {
  id               String          @id @default(uuid())
  source           String
  service          String?
  title            String
  message          String          @db.Text
  priority         String          @default("INFO")
  tags             String          @default("[]")
  hostname         String?
  externalId       String?
  timestamp        DateTime        @default(now())
  receivedAt       DateTime        @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?           @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])
  duplicateOf      String?
  duplicateCount   Int             @default(1)
  incidentId       String?
  incident         Incident?       @relation(fields: [incidentId], references: [id])
  routingResults   RoutingResult[]
  extra            String          @default("{}") @db.Text
  @@index([source])
  @@index([priority])
  @@index([timestamp])
  @@map("notifications")
}

model RoutingResult {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  ruleId         String?
  rule           Rule?        @relation(fields: [ruleId], references: [id])
  providerId     String
  provider       Provider     @relation(fields: [providerId], references: [id])
  status         String
  error          String?      @db.Text
  sentAt         DateTime     @default(now())
  @@map("routing_results")
}

// ─── Providers

model Provider {
  id             String          @id @default(uuid())
  name           String
  type           String
  isEnabled      Boolean         @default(true)
  config         String          @default("{}") @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  routingResults RoutingResult[]
  ruleActions    RuleAction[]
  @@map("providers")
}

// ─── Rules Engine

model Rule {
  id             String          @id @default(uuid())
  name           String
  description    String?         @db.Text
  isEnabled      Boolean         @default(true)
  priority       Int             @default(100)
  stopProcessing Boolean         @default(false)
  conditions     String          @default("[]") @db.Text
  conditionLogic String          @default("AND")
  actions        RuleAction[]
  routingResults RoutingResult[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@map("rules")
}

model RuleAction {
  id         String    @id @default(uuid())
  ruleId     String
  rule       Rule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type       String
  config     String    @default("{}") @db.Text
  sortOrder  Int       @default(0)
  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])
  @@map("rule_actions")
}

// ─── Escalation

model EscalationPolicy {
  id        String           @id @default(uuid())
  name      String
  isEnabled Boolean          @default(true)
  steps     EscalationStep[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@map("escalation_policies")
}

model EscalationStep {
  id         String           @id @default(uuid())
  policyId   String
  policy     EscalationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepNumber Int
  delayMins  Int              @default(10)
  providerId String
  message    String?          @db.Text
  @@map("escalation_steps")
}

model ActiveEscalation {
  id               String    @id @default(uuid())
  notificationId   String    @unique
  policyId         String
  currentStep      Int       @default(0)
  nextEscalationAt DateTime
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  @@map("active_escalations")
}

// ─── Incidents

model Incident {
  id            String         @id @default(uuid())
  title         String
  status        String         @default("OPEN")
  priority      String         @default("ERROR")
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?
  @@map("incidents")
}

// ─── Templates

model Template {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String?
  body      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("templates")
}

// ─── Settings

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  @@map("settings")
}

// ─── Audit Log

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    String   @default("{}") @db.Text
  ip         String?
  createdAt  DateTime @default(now())
  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
