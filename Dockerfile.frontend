# ============================================================
# NotificationHub – Frontend Dockerfile
# Multi-arch: linux/amd64, linux/arm64
# Build: docker build -f Dockerfile.frontend -t notificationhub-frontend .
# ============================================================

# --- Build stage ---
FROM node:22-alpine AS builder

WORKDIR /app

# Copy workspace manifests
COPY package.json package-lock.json* ./
COPY packages/frontend/package.json ./packages/frontend/

# Install frontend deps only
RUN npm ci --workspace=packages/frontend

# Copy frontend source
COPY packages/frontend ./packages/frontend

# Build Vite app
RUN npm run build --workspace=packages/frontend

# --- Runtime stage (nginx) ---
FROM nginx:1.27-alpine AS runner

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY --from=builder /app/packages/frontend/dist /usr/share/nginx/html

# nginx config: SPA fallback + gzip + proxy to backend API
# (backend host injected via BACKEND_HOST env at container start)
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

# Use envsubst to replace $BACKEND_HOST in nginx template at startup
CMD ["/bin/sh", "-c", "envsubst '$BACKEND_HOST' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
