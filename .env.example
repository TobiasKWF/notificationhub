# ============================================================
# NotificationHub – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
NODE_ENV=production
PORT=3003
HOST=0.0.0.0
APP_URL=http://localhost:3003
APP_SECRET=change-me-to-a-random-32-char-string

# --- Database ---
# Option A: SQLite (default, no extra setup)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./data/notificationhub.db

# Option B: MariaDB / MySQL (external, recommended for production)
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://notificationhub:secret@127.0.0.1:3306/notificationhub?connection_limit=10&socket_timeout=30

# Option C: PostgreSQL
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://notificationhub:secret@127.0.0.1:5432/notificationhub

# --- Authentication ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Default admin credentials (first run only – change immediately!)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# --- MQTT (optional ingestion source) ---
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=notifications/#

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json

# --- Security ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# --- Retention ---
RETENTION_DAYS=90
RETENTION_CRON="0 3 * * *"

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3003
VITE_WS_URL=ws://localhost:3003
